---
export interface Props {
  headings: {
    depth: number;
    slug: string;
    text: string;
  }[];
  title?: string;
}

const { headings, title = 'ON THIS PAGE' } = Astro.props;

const filteredHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const hasHeadings = filteredHeadings.length > 0;
---

{hasHeadings && (
  <nav class="toc-container" data-toc>
    <div class="toc-header">
      <svg class="toc-book-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
      </svg>
      <span class="toc-title">{title}</span>
    </div>

    <div class="toc-rail" aria-hidden="true">
      <div class="toc-rail-track"></div>
      <div class="toc-rail-thumb" data-toc-thumb></div>
    </div>

    <div class="toc-links" data-toc-links>
      {filteredHeadings.map((heading) => (
        <a
          href={`#${heading.slug}`}
          class={`toc-link depth-${heading.depth}`}
          data-toc-link
          data-heading-slug={heading.slug}
        >
          {heading.text}
        </a>
      ))}
    </div>
  </nav>
)}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tocContainer = document.querySelector('[data-toc]');
    const tocLinks = document.querySelectorAll('[data-toc-link]');
    const tocThumb = document.querySelector('[data-toc-thumb]');
    const tocLinksContainer = document.querySelector('[data-toc-links]');

    if (!tocContainer || !tocLinks.length || !tocThumb || !tocLinksContainer) return;

    const isDesktop = window.innerWidth >= 1024;
    const headerOffset = 64;

    if (!isDesktop) {
      tocContainer.style.display = 'none';
      return;
    }

    const headingElements = Array.from(tocLinks).map((link) => {
      const slug = link.getAttribute('data-heading-slug');
      return document.getElementById(slug);
    }).filter(Boolean);

    if (!headingElements.length) return;

    const updateActiveLink = (activeSlug: string) => {
      tocLinks.forEach((link) => {
        const slug = link.getAttribute('data-heading-slug');
        if (slug === activeSlug) {
          link.classList.add('active');
          const linkRect = link.getBoundingClientRect();
          const containerRect = tocLinksContainer.getBoundingClientRect();
          const top = linkRect.top - containerRect.top + tocLinksContainer.scrollTop;
          const height = linkRect.height;
          tocThumb.style.top = `${top}px`;
          tocThumb.style.height = `${height}px`;
        } else {
          link.classList.remove('active');
        }
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const slug = entry.target.id;
            updateActiveLink(slug);
          }
        });
      },
      {
        rootMargin: `-${headerOffset}px 0px -80% 0px`,
        threshold: 0,
      }
    );

    headingElements.forEach((el) => observer.observe(el));

    let activeSlug = '';
    const checkActive = () => {
      const scrollY = window.scrollY + headerOffset + 10;
      for (let i = headingElements.length - 1; i >= 0; i--) {
        const el = headingElements[i];
        if (el && el.offsetTop <= scrollY) {
          if (el.id !== activeSlug) {
            activeSlug = el.id;
            updateActiveLink(activeSlug);
          }
          break;
        }
      }
    };

    window.addEventListener('scroll', checkActive, { passive: true });
    checkActive();

    tocLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const slug = link.getAttribute('data-heading-slug');
        const target = document.getElementById(slug);
        if (target) {
          const targetPosition = target.getBoundingClientRect().top + window.scrollY - headerOffset;
          window.scrollTo({ top: targetPosition, behavior: 'smooth' });
          history.pushState(null, '', `#${slug}`);
        }
      });
    });

    const handleResize = () => {
      const newIsDesktop = window.innerWidth >= 1024;
      if (newIsDesktop !== isDesktop) {
        location.reload();
      }
    };
    window.addEventListener('resize', handleResize);
  });
</script>

<style>
  .toc-container {
    position: fixed;
    top: 64px;
    left: calc(50% + 260px);
    width: 340px;
    height: calc(100vh - 64px);
    padding-top: 3rem;
    z-index: 40;
    pointer-events: none;
  }

  .toc-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 0.75rem;
    margin-bottom: 1.5rem;
    pointer-events: auto;
  }

  .toc-book-icon {
    flex-shrink: 0;
    color: hsl(var(--muted-foreground));
    opacity: 0.7;
  }

  .toc-title {
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: hsl(var(--muted-foreground));
    line-height: 1;
  }

  .toc-rail {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 10px;
    overflow: hidden;
    pointer-events: none;
  }

  .toc-rail-track {
    position: absolute;
    inset: 0;
    background-color: hsl(var(--muted) / 0.5);
  }

  .dark .toc-rail-track {
    background-color: hsl(var(--muted) / 0.3);
  }

  .toc-rail-thumb {
    position: absolute;
    left: 0;
    width: 100%;
    background-color: hsl(var(--foreground));
    border-radius: 9999px;
    transition: top 0.2s ease, height 0.2s ease;
    pointer-events: none;
    top: 0;
    height: 0;
  }

  .toc-links {
    position: relative;
    padding-left: 1.5rem;
    height: calc(100% - 4rem);
    overflow-y: auto;
    pointer-events: auto;
    scrollbar-width: thin;
    scrollbar-color: hsl(var(--muted-foreground) / 0.3) transparent;
  }

  .toc-links::-webkit-scrollbar {
    width: 4px;
  }

  .toc-links::-webkit-scrollbar-track {
    background: transparent;
  }

  .toc-links::-webkit-scrollbar-thumb {
    background-color: hsl(var(--muted-foreground) / 0.3);
    border-radius: 9999px;
  }

  .toc-link {
    display: block;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: hsl(var(--muted-foreground));
    text-decoration: none;
    padding: 0.125rem 0;
    transition: color 0.15s ease;
    white-space: normal;
    word-break: break-word;
  }

  .toc-link:hover {
    color: hsl(var(--foreground));
  }

  .toc-link.active {
    color: hsl(var(--foreground));
    font-weight: 500;
  }

  .depth-2 {
    padding-left: 0;
  }

  .depth-3 {
    padding-left: 24px;
    font-size: 0.75rem;
  }

  @media (max-width: 1023px) {
    .toc-container {
      position: relative;
      top: auto;
      left: auto;
      width: 100%;
      height: auto;
      padding-top: 0;
      padding: 1.5rem;
      margin-bottom: 1.5rem;
      pointer-events: auto;
      background-color: hsl(var(--card));
      border-radius: var(--radius);
      border: 1px solid hsl(var(--border));
    }

    .toc-header {
      margin-bottom: 1rem;
    }

    .toc-rail {
      display: none;
    }

    .toc-links {
      height: auto;
      max-height: none;
      padding-left: 1rem;
      overflow: visible;
    }

    .depth-3 {
      padding-left: 1.5rem;
    }
  }

  @media (min-width: 1024px) and (max-width: 1399px) {
    .toc-container {
      left: calc(50% + 200px);
      width: 280px;
    }
  }

  @media (min-width: 1400px) and (max-width: 1599px) {
    .toc-container {
      left: calc(50% + 240px);
      width: 320px;
    }
  }
</style>