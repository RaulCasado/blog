---
export interface Props {
  headings: {
    depth: number;
    slug: string;
    text: string;
  }[];
  title?: string;
}

const { headings, title = 'ON THIS PAGE' } = Astro.props;

const filteredHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const hasHeadings = filteredHeadings.length > 0;
---

{hasHeadings && (
  <nav class="toc" data-toc aria-label={title}>
    <div class="toc-label">
      <svg class="toc-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M8 4.667A2.667 2.667 0 0 0 5.333 2h-4v10H6a2 2 0 0 1 2 2m0-9.333V14m0-9.333A2.667 2.667 0 0 1 10.667 2h4v10H10a2 2 0 0 0-2 2M4 5.333h1.333M4 8h1.333m5.334-2.667H12M10.667 8H12"></path>
      </svg>
      <span>{title}</span>

      <button type="button" class="toc-toggle" data-toc-toggle aria-expanded="false">
        <span class="sr-only">{title}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>

    <div class="toc-body">
      <div class="toc-rail" aria-hidden="true">
        <div class="toc-rail-track"></div>
        <div class="toc-rail-thumb" data-toc-thumb></div>
      </div>

      <div class="toc-list" data-toc-list>
        {filteredHeadings.map((heading) => (
          <a
            href={`#${heading.slug}`}
            class={`toc-item depth-${heading.depth}`}
            data-toc-item
            data-slug={heading.slug}
          >
            {heading.text}
          </a>
        ))}
      </div>
    </div>
  </nav>
)}

<script>
  function initToc() {
    const nav = document.querySelector<HTMLElement>('[data-toc]');
    const list = document.querySelector<HTMLElement>('[data-toc-list]');
    const thumb = document.querySelector<HTMLElement>('[data-toc-thumb]');
    const items = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-item]'));
    if (!nav || !list || !thumb || !items.length) return;

    const headings = items
      .map((item) => document.getElementById(item.dataset.slug ?? ''))
      .filter((el): el is HTMLElement => Boolean(el));
    if (!headings.length) return;

    // Keep the sticky offset in sync with the site header height.
    const headerOffset =
      parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) * 16 || 64;

    let current = '';

    const paint = (slug: string) => {
      if (slug === current) return;
      current = slug;

      items.forEach((item) => {
        const isActive = item.dataset.slug === slug;
        item.classList.toggle('active', isActive);
        if (!isActive) return;

        // Match the rail thumb to the active item's box inside the list.
        thumb.style.top = `${item.offsetTop}px`;
        thumb.style.height = `${item.offsetHeight}px`;
      });
    };

    const sync = () => {
      const line = window.scrollY + headerOffset + 24;
      let active = headings[0];
      for (const heading of headings) {
        if (heading.offsetTop <= line) active = heading;
        else break;
      }
      // Near the bottom the last section may never cross the line on short pages.
      if (window.innerHeight + window.scrollY >= document.body.scrollHeight - 4) {
        active = headings[headings.length - 1];
      }
      paint(active.id);
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        sync();
        ticking = false;
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    sync();

    const toggle = document.querySelector<HTMLButtonElement>('[data-toc-toggle]');
    const setOpen = (open: boolean) => {
      nav.classList.toggle('open', open);
      toggle?.setAttribute('aria-expanded', String(open));
    };

    toggle?.addEventListener('click', () => setOpen(!nav.classList.contains('open')));

    items.forEach((item) => {
      item.addEventListener('click', (event) => {
        const target = document.getElementById(item.dataset.slug ?? '');
        if (!target) return;
        event.preventDefault();
        window.scrollTo({
          top: target.getBoundingClientRect().top + window.scrollY - headerOffset - 16,
          behavior: 'smooth',
        });
        history.pushState(null, '', `#${item.dataset.slug}`);
        // On the collapsed mobile card, jumping should also close the list.
        if (window.matchMedia('(max-width: 1023px)').matches) setOpen(false);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initToc);
  } else {
    initToc();
  }
</script>

<style>
  .toc {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    max-height: calc(100vh - var(--header-h) - 3rem);
    display: flex;
    flex-direction: column;
  }

  .toc-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    margin-bottom: 1rem;
    font-size: var(--eyebrow-size);
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: hsl(var(--muted-foreground));
  }

  .toc-icon {
    flex-shrink: 0;
  }

  /* Collapse control — only meaningful on the mobile card */
  .toc-toggle {
    display: none;
    margin-left: auto;
    padding: 0;
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .toc-toggle svg {
    display: block;
    transition: transform 0.2s ease;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .toc-body {
    position: relative;
    min-height: 0;
    overflow-y: auto;
    scrollbar-width: none;
  }

  .toc-body::-webkit-scrollbar {
    display: none;
  }

  /* The 10px guide rail: a static track with a thumb that tracks the
     active item's box, matching refine's scroll indicator. */
  .toc-rail {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 10px;
    pointer-events: none;
  }

  .toc-rail-track {
    position: absolute;
    left: 1px;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: hsl(var(--border));
  }

  .toc-rail-thumb {
    position: absolute;
    left: 0;
    top: 0;
    width: 3px;
    height: 0;
    border-radius: var(--pill-radius);
    background-color: hsl(var(--foreground));
    transition: top 0.2s ease, height 0.2s ease;
  }

  .toc-list {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-bottom: 3rem;
  }

  .toc-item {
    display: block;
    padding: 0.5rem 1rem 0.5rem 1.5rem;
    font-size: 0.875rem;
    line-height: 1.4;
    color: hsl(var(--muted-foreground));
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .toc-item.depth-3 {
    padding-left: 2.25rem;
    font-size: 0.8125rem;
  }

  .toc-item:hover {
    color: hsl(var(--foreground));
  }

  .toc-item.active {
    color: hsl(var(--foreground));
  }

  /* Below the two-column breakpoint the TOC becomes a normal card above
     the article, so the rail and sticky behaviour are dropped. */
  @media (max-width: 1023px) {
    .toc {
      position: static;
      max-height: none;
      padding: 1rem 1.25rem;
      margin-bottom: 2rem;
      background-color: hsl(var(--card));
      border: 1px solid hsl(var(--border));
      border-radius: var(--radius-lg);
    }

    .toc-label {
      margin-bottom: 0;
    }

    .toc-toggle {
      display: block;
    }

    /* Collapsed by default so a long outline doesn't bury the article */
    .toc-body {
      display: none;
      overflow-y: visible;
    }

    .toc.open .toc-body {
      display: block;
      margin-top: 1rem;
    }

    .toc.open .toc-toggle svg {
      transform: rotate(180deg);
    }

    .toc-rail {
      display: none;
    }

    .toc-list {
      padding-bottom: 0;
    }

    .toc-item {
      padding-left: 0;
    }

    .toc-item.depth-3 {
      padding-left: 1rem;
    }
  }
</style>
