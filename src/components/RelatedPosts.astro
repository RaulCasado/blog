---
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import fallbackHeroImage from '../assets/blog/blog-placeholder-1.jpg';
import { getReadingTime, postSlug } from '../utils/posts';

interface Props {
	posts: CollectionEntry<'blog'>[];
	lang: string;
	title: string;
	minRead: string;
}

const { posts, lang, title, minRead } = Astro.props;
const locale = lang === 'es' ? 'es-ES' : 'en-US';
const postUrl = (post: CollectionEntry<'blog'>) => `/${lang}/blog/${postSlug(post.id, lang)}/`;
---

{posts.length > 0 && (
	<section class="related" aria-labelledby="related-title">
		<h2 id="related-title">{title}</h2>
		<ul class="related-list">
			{posts.map((post) => (
				<li>
					<a class="related-item" href={postUrl(post)}>
						<span class="related-media">
							<Picture
								src={post.data.heroImage || fallbackHeroImage}
								alt=""
								width={320}
								height={200}
								widths={[160, 320]}
								sizes="(min-width: 640px) 160px, 112px"
								formats={['avif', 'webp']}
								loading="lazy"
							/>
						</span>
						<span class="related-text">
							<span class="related-meta">
								<time datetime={post.data.pubDate.toISOString()}>
									{post.data.pubDate.toLocaleDateString(locale, { year: 'numeric', month: 'short', day: 'numeric' })}
								</time>
								<span aria-hidden="true">·</span>
								<span>{getReadingTime(post)} {minRead}</span>
							</span>
							<span class="related-title">{post.data.title}</span>
						</span>
					</a>
				</li>
			))}
		</ul>
	</section>
)}

<style>
	.related {
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid hsl(var(--line));
	}

	.related h2 {
		margin: 0 0 1.25rem;
		font-size: 1.25rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: hsl(var(--prose-heading));
	}

	.related-list {
		display: grid;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.related-item {
		display: grid;
		grid-template-columns: 7rem 1fr;
		gap: 1rem;
		align-items: center;
		color: inherit;
		text-decoration: none;
	}

	.related-media {
		display: block;
		overflow: hidden;
		border-radius: var(--corner);
		background-color: hsl(var(--wash));
	}

	.related-media :global(img) {
		display: block;
		width: 100%;
		aspect-ratio: 8 / 5;
		height: auto;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.related-item:hover .related-media :global(img) {
		transform: scale(1.04);
	}

	.related-text {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		min-width: 0;
	}

	.related-meta {
		display: flex;
		gap: 0.4rem;
		font-family: var(--font-mono);
		font-size: var(--eyebrow-size);
		letter-spacing: var(--eyebrow-tracking);
		text-transform: uppercase;
		color: hsl(var(--ink-soft));
	}

	.related-title {
		font-size: 1.0625rem;
		font-weight: 600;
		line-height: 1.3;
		color: hsl(var(--ink));
		text-wrap: balance;
		transition: color 0.2s ease;
	}

	.related-item:hover .related-title,
	.related-item:focus-visible .related-title {
		color: hsl(var(--brand));
	}

	@media (min-width: 640px) {
		.related-item {
			grid-template-columns: 10rem 1fr;
			gap: 1.25rem;
		}

		.related-title {
			font-size: 1.1875rem;
		}
	}
</style>
