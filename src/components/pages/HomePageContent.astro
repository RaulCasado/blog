---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import profileImage from '../../assets/profile/raul_casado.png';
import fallbackHeroImage from '../../assets/blog/blog-placeholder-1.jpg';
import { getLangPosts, postSlug } from '../../utils/posts';
import ContactCTA from '../ContactCTA.astro';
const { lang, t, translatePath } = Astro.props;

// Real product shots: the three posts the blog index leads with, with their own covers.
const latestPosts = getLangPosts(await getCollection('blog'), lang).slice(0, 3);
const dateLocale = lang === 'es' ? 'es-ES' : 'en-GB';

// Text-only index (no icon tiles): number + title + one line + link.
const sections = ['blog', 'portfolio', 'about'] as const;
---

<section class="hero">
	<div class="container">
		<div class="hero-content">
			<div class="hero-text">
				<h1>{t('hero.greeting')}</h1>
				<p>{t('hero.tagline')}</p>
				<div class="cta-buttons">
					<a href={translatePath('portfolio')} class="btn btn-primary">{t('hero.cta.projects')}</a>
					<a href={translatePath('about')} class="btn btn-outline">{t('hero.cta.about')}</a>
				</div>
			</div>
			<div class="hero-image">
				<Picture
					src={profileImage}
					alt="Raúl Casado - Desarrollador Web"
					width={400}
					height={400}
					formats={['avif', 'webp']}
					fallbackFormat="png"
					loading="eager"
					quality={85}
				/>
			</div>
		</div>
	</div>
</section>

<!-- Latest posts: real covers, real content -->
<section class="latest">
	<div class="container">
		<div class="section-head">
			<div class="section-head-text">
				<h2>{t('latest.title')}</h2>
				<p>{t('latest.description')}</p>
			</div>
			<a href={translatePath('blog')} class="section-head-link">{t('latest.all')} <span aria-hidden="true">→</span></a>
		</div>

		<div class="post-grid">
			{latestPosts.map((post) => (
				<article class="post">
					<a class="post-media" href={translatePath(`blog/${postSlug(post.id, lang)}/`)} tabindex="-1" aria-hidden="true">
						<Picture
							src={post.data.heroImage || fallbackHeroImage}
							alt=""
							width={720}
							height={480}
							widths={[360, 540, 720]}
							sizes="(min-width: 900px) 30vw, 100vw"
							formats={['avif', 'webp']}
							loading="lazy"
						/>
					</a>
					<p class="post-meta">
						<time datetime={post.data.pubDate.toISOString()}>
							{post.data.pubDate.toLocaleDateString(dateLocale, { year: 'numeric', month: 'short', day: 'numeric' })}
						</time>
					</p>
					<h3>
						<a href={translatePath(`blog/${postSlug(post.id, lang)}/`)}>{post.data.title}</a>
					</h3>
					{post.data.description && <p class="post-description">{post.data.description}</p>}
				</article>
			))}
		</div>
	</div>
</section>

<!-- Where to go next: text with hierarchy, no icon tiles -->
<section class="features">
	<div class="container split">
		<div class="split-head">
			<h2>{t('features.title')}</h2>
			<p>{t('features.description')}</p>
		</div>

		<ol class="index">
			{sections.map((key, i) => (
				<li class="index-row">
					<span class="index-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
					<div class="index-body">
						<h3>{t(`card.${key}.title`)}</h3>
						<p>{t(`card.${key}.description`)}</p>
					</div>
					<a href={translatePath(key)} class="index-link">{t(`card.${key}.link`)} <span aria-hidden="true">→</span></a>
				</li>
			))}
		</ol>
	</div>
</section>

<!-- Tech Stack Section -->
<section class="tech-stack">
	<div class="container split">
		<div class="split-head">
			<h2>{t('tech.title')}</h2>
			<p>{t('tech.description')}</p>
			<a href={translatePath('about')} class="stack-link">{t('tech.viewFullStack')} <span aria-hidden="true">→</span></a>
		</div>
		<div class="tech-icons">
						<div class="tech-icon">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" width="40" height="40" fill="#F7DF1E">
