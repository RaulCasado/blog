							</svg>
							<p>React</p>
						</div>
					</div>
	</div>
</section>

<ContactCTA lang={lang} />

<style>
	main {
		min-height: calc(100vh - 4rem);
		display: flex;
		flex-direction: column;
		width: 100%;
		max-width: 100vw;
		overflow-x: hidden;
	}

	/* Container: one left edge for every section */
	.container {
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.25rem;
		box-sizing: border-box;
	}

	section {
		padding: 3rem 0;
	}

	/* Hero */
	.hero {
		background-color: transparent;
		padding: 2.5rem 0 3rem;
		border-bottom: 1px solid hsl(var(--line));
	}

	.hero-content {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
		align-items: center;
	}

	.hero-text {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		text-align: left;
	}

	.hero-text h1 {
		font-size: clamp(2.5rem, 7vw, 4.5rem);
		font-weight: 500;
		line-height: 1.02;
		letter-spacing: -0.03em;
		margin: 0;
		text-wrap: balance;
	}

	.hero-text p {
		font-size: 1.125rem;
		line-height: 1.6;
		color: hsl(var(--ink-soft));
		max-width: 52ch;
		margin: 0;
	}

	.hero-image img {
		display: block;
		width: 100%;
		max-width: 22rem;
		aspect-ratio: 1;
		height: auto;
		object-fit: cover;
		border-radius: var(--corner);
	}

	.cta-buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0.5rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.7rem 1.25rem;
		border-radius: var(--corner);
		font-weight: 600;
		text-decoration: none;
		transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
		font-size: 0.9375rem;
	}

	.btn-primary {
		background-color: hsl(var(--brand));
		border: 1px solid hsl(var(--brand));
		color: hsl(var(--brand-ink));
	}

	.btn-primary:hover {
		color: hsl(var(--brand-ink));
		opacity: 0.9;
	}

	.btn-outline {
		background-color: transparent;
		border: 1px solid hsl(var(--line-strong));
		color: hsl(var(--ink));
	}

	.btn-outline:hover {
		border-color: hsl(var(--ink));
		color: hsl(var(--ink));
	}

	/* Section heads: left-aligned */
	h2 {
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		font-weight: 500;
		line-height: 1.1;
		letter-spacing: -0.025em;
		margin: 0 0 0.75rem;
		text-wrap: balance;
	}

	.section-head p,
	.split-head p {
		color: hsl(var(--ink-soft));
		line-height: 1.6;
		margin: 0;
		max-width: 46ch;
	}

	.section-head {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
		margin-bottom: 2rem;
	}

	.section-head-link,
	.stack-link,
	.index-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: hsl(var(--brand));
		text-decoration: none;
		font-weight: 600;
		font-size: 0.9375rem;
	}

	.section-head-link span,
	.stack-link span,
	.index-link span {
		transition: transform 0.2s ease;
	}

	.section-head-link:hover span,
	.stack-link:hover span,
	.index-link:hover span {
		transform: translateX(4px);
	}

	.stack-link {
		margin-top: 1.25rem;
	}

	/* Latest posts */
	.post-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.25rem;
	}

	.post-media {
		display: block;
		overflow: hidden;
		border-radius: var(--corner);
		background-color: hsl(var(--wash));
		margin-bottom: 1rem;
	}

	.post-media img {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 2;
		height: auto;
		object-fit: cover;
		border-radius: 0;
		transition: transform 0.4s ease;
	}

	.post:hover .post-media img {
		transform: scale(1.03);
	}

	.post-meta {
		font-family: var(--font-mono);
		font-size: var(--eyebrow-size);
		letter-spacing: var(--eyebrow-tracking);
		text-transform: uppercase;
		color: hsl(var(--ink-soft));
		margin: 0 0 0.5rem;
	}

	.post h3 {
		font-size: 1.375rem;
		line-height: 1.2;
		margin: 0 0 0.5rem;
		text-wrap: balance;
	}

	.post h3 a {
		text-decoration: none;
	}

	.post h3 a:hover {
		color: hsl(var(--brand));
	}

	.post-description {
		color: hsl(var(--ink-soft));
		font-size: 0.9375rem;
		line-height: 1.55;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* Split layout: heading column + content column on a 12-col grid */
	.split {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
	}

	.split-head {
		align-self: start;
	}

	/* Text index */
	.features {
		border-top: 1px solid hsl(var(--line));
	}

	.index {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid hsl(var(--ink));
	}

	.index-row {
		display: grid;
		grid-template-columns: 2.25rem 1fr;
		column-gap: 0.75rem;
		row-gap: 0.75rem;
		padding: 1.5rem 0;
		border-bottom: 1px solid hsl(var(--line));
	}

	.index-num {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: hsl(var(--brand));
		padding-top: 0.45rem;
	}

	.index-body h3 {
		font-size: 1.625rem;
		line-height: 1.15;
		margin: 0 0 0.4rem;
	}

	.index-body p {
		color: hsl(var(--ink-soft));
		margin: 0;
		max-width: 48ch;
		line-height: 1.55;
	}

	.index-link {
		grid-column: 2;
	}

	/* Tech stack */
	.tech-stack {
		border-top: 1px solid hsl(var(--line));
		background-color: hsl(var(--wash));
	}

	.tech-icons {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem 1.5rem;
		align-content: start;
	}

	.tech-icon {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.6rem;
	}

	.tech-icon svg {
		width: 44px;
		height: 44px;
	}

	.tech-icon p {
		margin: 0;
		font-size: 0.875rem;
		font-weight: 500;
	}

