---
export interface Props {
  url: string;
  title: string;
  description?: string;
  lang?: string;
}

const { url, title, description, lang = 'es' } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const encodedDescription = description ? encodeURIComponent(description) : '';
const isEnglish = lang === 'en';
const shareLabel = isEnglish ? 'Share on:' : 'Compartir en:';
const shareOn = isEnglish ? 'Share on' : 'Compartir en';
const copyLabel = isEnglish ? 'Copy link' : 'Copiar enlace';
const copiedLabel = isEnglish ? 'Link copied' : 'Enlace copiado';

const platforms = [
  {
    name: 'X',
    brand: '#000000',
    href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
    path: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  },
  {
    name: 'Reddit',
    brand: '#FF4500',
    href: `https://www.reddit.com/submit?url=${encodedUrl}&title=${encodedTitle}`,
    path: 'M12 0C5.373 0 0 5.373 0 12c0 3.314 1.343 6.314 3.515 8.485l-2.286 2.286A.72.72 0 0 0 1.738 24H12c6.627 0 12-5.373 12-12S18.627 0 12 0m4.388 3.199a1.999 1.999 0 1 1-1.947 2.46v.002a2.37 2.37 0 0 0-2.032 2.341v.007c1.334.024 2.559.485 3.535 1.234a2.86 2.86 0 0 1 1.943-.765 2.87 2.87 0 0 1 1.001 5.559 4.5 4.5 0 0 1 .062.723c0 2.677-3.104 4.85-6.934 4.85s-6.93-2.173-6.93-4.85c0-.25.021-.494.06-.732a2.87 2.87 0 1 1 2.949-4.8 6.3 6.3 0 0 1 3.522-1.218v-.01a3.6 3.6 0 0 1 3.108-3.564 2 2 0 0 1 1.943-1.237zM9.44 12.16a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.88m5.13 0a1.44 1.44 0 1 0-.001 2.882 1.44 1.44 0 0 0 0-2.882m-4.85 4.997a.485.485 0 0 0-.334.833c.877.874 2.309.938 3.616.938s2.738-.064 3.615-.938a.49.49 0 0 0-.007-.687.49.49 0 0 0-.688-.006c-.554.554-1.739.752-2.92.752s-2.366-.198-2.92-.752a.49.49 0 0 0-.362-.14',
  },
  {
    name: 'LinkedIn',
    brand: '#0A66C2',
    href: `https://www.linkedin.com/shareArticle?mini=true&url=${encodedUrl}&title=${encodedTitle}&summary=${encodedDescription}`,
    path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  },
];
---

<div class="share">
  <span class="share-label">{shareLabel}</span>

  <div class="share-buttons">
    {platforms.map((platform) => (
      <a
        href={platform.href}
        target="_blank"
        rel="noopener noreferrer"
        class="share-button"
        style={`--brand: ${platform.brand}`}
        aria-label={`${shareOn} ${platform.name}`}
        title={`${shareOn} ${platform.name}`}
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d={platform.path}></path>
        </svg>
      </a>
    ))}

    <button type="button" class="share-button copy-button" aria-label={copyLabel} title={copyLabel}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
    </button>
  </div>

  <span class="share-feedback" data-share-feedback aria-live="polite"></span>
</div>

<script define:vars={{ copiedLabel }}>
  document.querySelectorAll('.copy-button').forEach((button) => {
    const feedback = button.closest('.share')?.querySelector('[data-share-feedback]');

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        if (!feedback) return;
        feedback.textContent = copiedLabel;
        setTimeout(() => {
          feedback.textContent = '';
        }, 2000);
      } catch (error) {
        console.error('Error copying link:', error);
      }
    });
  });
</script>

<style>
  .share {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .share-label {
    font-size: var(--eyebrow-size);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--eyebrow-tracking);
    color: hsl(var(--muted-foreground));
    white-space: nowrap;
  }

  .share-buttons {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Brand-tinted 32px squares, matching refine's share row */
  .share-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    color: #fff;
    background-color: var(--brand, hsl(var(--secondary)));
    border: 1px solid hsl(0 0% 100% / 0.08);
    border-radius: 0.375rem;
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .share-button:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  .share-button svg {
    width: 15px;
    height: 15px;
  }

  .copy-button {
    color: hsl(var(--muted-foreground));
    background-color: hsl(var(--secondary));
    border-color: hsl(var(--border));
  }

  .copy-button:hover {
    color: hsl(var(--foreground));
  }

  .share-feedback {
    position: absolute;
    top: calc(100% + 0.375rem);
    right: 0;
    font-size: 0.6875rem;
    color: hsl(var(--primary));
    white-space: nowrap;
    pointer-events: none;
  }

  /* X keeps a light glyph on black in both themes; give it a visible edge
     in dark mode where the tile would otherwise vanish into the page. */
  :global(.dark) .share-button[style*='#000000'] {
    border-color: hsl(0 0% 100% / 0.18);
  }
</style>
