---
import StandardPageLayout from '../../layouts/StandardPageLayout.astro';
import { useTranslations, defaultLanguage } from '../../i18n/utils';
import { languages } from '../../i18n/ui';

import AboutPageContent from '../../components/pages/AboutPageContent.astro';
import CvPageContent from '../../components/pages/CvPageContent.astro';
import PortfolioPageContent from '../../components/pages/PortfolioPageContent.astro';
import UsesPageContent from '../../components/pages/UsesPageContent.astro';

export async function getStaticPaths() {
  const pagesToTranslate = [
    { name: 'about', component: AboutPageContent },
    { name: 'cv', component: CvPageContent },
    { name: 'portfolio', component: PortfolioPageContent },
    { name: 'uses', component: UsesPageContent },
  ];

  const paths = [];

  for (const langKey of Object.keys(languages)) {
    for (const page of pagesToTranslate) {
      paths.push({
        params: {
          lang: langKey,
          page: page.name
        },
        props: {
          pageName: page.name,
          component: page.component
        }
      });
    }
  }

  return paths;
}

const { lang, page } = Astro.params;
const { pageName, component: PageContentComponent, page: pageData, allProjects } = Astro.props;

const t = useTranslations(lang);

const pageTitleKey = `${pageName}.title`;
const pageDescriptionKey = `${pageName}.description`;
// Pages that define a name-bearing meta title/description use them for <head>
// only; the on-page heading keeps using `${pageName}.title`.
const metaTitleKey = `${pageName}.metaTitle` as typeof pageTitleKey;
const metaDescriptionKey = `${pageName}.metaDescription` as typeof pageDescriptionKey;

const htmlLang = lang || defaultLanguage;
---

<StandardPageLayout
  title={t(metaTitleKey) || t(pageTitleKey)}
  description={t(metaDescriptionKey) || t(pageDescriptionKey)}
  lang={htmlLang}
  pageType={pageName === 'about' ? 'about' : pageName === 'cv' ? 'cv' : 'page'}
>
  <PageContentComponent lang={lang} page={pageData} allProjects={allProjects} />
</StandardPageLayout>